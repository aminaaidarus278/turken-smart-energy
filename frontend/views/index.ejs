      <!-- Right: Quotation & Contact Form -->
      <div class="contact-form-card">
        <h3 class="form-title">Request a Quotation</h3>
        <p class="form-subtitle">Fill out the form below and our trading desk will respond promptly.</p>

        <form action="/contact" method="POST" class="contact-form">
          <div class="form-row">
            <div class="form-group">
              <label for="fullName">Full Name *</label>
              <input type="text" id="fullName" name="fullName" required placeholder="John Doe">
            </div>
            <div class="form-group">
              <label for="company">Company Name *</label>
              <input type="text" id="company" name="company" required placeholder="Energy Logistics Ltd">
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="email">Work Email *</label>
              <input type="email" id="email" name="email" required placeholder="name@company.com">
            </div>
            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input type="tel" id="phone" name="phone" placeholder="+254 ...">
            </div>
          </div>

          <div class="form-group">
            <label for="productInterest">Product / Service Interest *</label>
            <select id="productInterest" name="productInterest" required>
              <option value="" disabled selected>Select an option</option>
              <option value="EN590 Diesel">EN590 Diesel</option>
              <option value="Automotive Gas Oil (AGO)">Automotive Gas Oil (AGO)</option>
              <option value="Gasoline / Petrol">Gasoline / Petrol</option>
              <option value="Jet Fuel">Jet Fuel</option>
              <option value="Smart Energy Solutions">Smart Energy Solutions</option>
              <option value="Renewable Energy">Renewable Energy</option>
              <option value="Strategic Partnership">Strategic Partnership</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Requirement Details *</label>
            <textarea id="message" name="message" rows="4" required placeholder="Please state target volumes, destination port/location, and required terms..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary form-submit-btn">Submit Request →</button>
        </form>
      </div>

    </div>
  </div>
</section>

