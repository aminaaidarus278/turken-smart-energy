<!-- SECTION 6: PROCESS STEPPER WITH TANKER SHIP IMAGE -->
<section id="process" class="process-section">
  <div class="container">
    <div class="process-grid">
      
      <!-- Left Tanker Ship Image -->
      <div class="process-img-wrapper">
        <img src="/images/hero-bg.jpg" alt="Energy Tanker Ship" class="process-img">
      </div>

      <!-- Right Steps Flow -->
      <div>
        <div class="process-header">
          <p class="process-main-heading">Our Trading & Supply Process</p>
          <p class="section-subtitle-sm margin-0">FROM REQUIREMENT TO DELIVERY.</p>
        </div>

        <div class="process-steps-flow">
          <div class="process-step">
            <span class="step-num">01</span>
            <h6 class="step-title">REQUIREMENT</h6>
            <p class="step-desc">Product, quantity, destination, terms.</p>
          </div>
          <span class="step-arrow">→</span>

          <div class="process-step">
            <span class="step-num">02</span>
            <h6 class="step-title">SOURCING</h6>
            <p class="step-desc">Identify suitable supply opportunities.</p>
          </div>
          <span class="step-arrow">→</span>

          <div class="process-step">
            <span class="step-num">03</span>
            <h6 class="step-title">VERIFICATION</h6>
            <p class="step-desc">Commercial and counterparty review.</p>
          </div>
          <span class="step-arrow">→</span>

          <div class="process-step">
            <span class="step-num">04</span>
            <h6 class="step-title">STRUCTURING</h6>
            <p class="step-desc">Price, specifications, terms and payment.</p>
          </div>
          <span class="step-arrow">→</span>

          <div class="process-step">
            <span class="step-num">05</span>
            <h6 class="step-title">CONTRACTING</h6>
            <p class="step-desc">Agreements and documentation.</p>
          </div>
          <span class="step-arrow">→</span>

          <div class="process-step">
            <span class="step-num">06</span>
            <h6 class="step-title">DELIVERY</h6>
            <p class="step-desc">Shipment and delivery arrangements.</p>
          </div>

          <div class="process-summary-box">
            <strong class="process-summary-text">SMARTER TRADING.<br>CLEARER COMMUNICATION.<br>BETTER EXECUTION.</strong>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

